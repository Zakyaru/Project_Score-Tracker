{
  "name": "project_score-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API to track score of games with your friends.",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zakyaru/Project_Score-Tracker.git"
  },
  "keywords": [],
  "author": "Arseni Ergin",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zakyaru/Project_Score-Tracker/issues"
  },
  "homepage": "https://github.com/Zakyaru/Project_Score-Tracker#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
